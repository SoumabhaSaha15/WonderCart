{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "allowJs": true,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "paths": {
      "#/*": ["./src/*"]
    },
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "esModuleInterop": true,
    "declaration": false
  },
  "tsc-alias": {
    "verbose": true,
    "resolve-full-paths": true
  },
  "include": ["./src/**/*", "./types"]
}

{
  "name": "wonder_cart",
  "version": "1.0.0",
  "description": "MERN E-commerce App --- Feature & Technology Checklist",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "workspaces": [
    "./packages/client",
    "./packages/server"
  ],
  "type": "module",
  "main": "index.js",
  "scripts": {
    "add:client": "pnpm --filter=./packages/client add",
    "add:server": "pnpm --filter=./packages/server add",
    "fmt": "pnpm -r --if-present fmt",
    "fmt:client": "pnpm --dir packages/client fmt",
    "fmt:server": "pnpm --dir packages/server fmt",
    "lint": "pnpm -r --if-present lint",
    "lint:client": "pnpm --dir packages/client lint",
    "lint:server": "pnpm --dir packages/server lint",
    "dev": "pnpm --parallel -r dev",
    "dev:client": "pnpm --dir packages/client dev",
    "dev:server": "pnpm --dir packages/server dev",
    "build": "pnpm -r --if-present build",
    "build:client": "pnpm --dir packages/client build",
    "build:server": "pnpm --dir packages/server build",
    "start": "pnpm --dir packages/server start"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.x"
  }
}
